{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "types": ["node"],

    /* The generator in tools/ reaches into src/ for the fixture blueprints and
       the shared metrics maths, so this project has to resolve "@/" too. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["*.config.ts", "eslint.config.js", "tools/**/*.ts", "e2e/**/*.ts"]
}
