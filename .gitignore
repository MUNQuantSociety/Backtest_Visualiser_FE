# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Deploy provider artifacts
.vercel/
.netlify/

# Environment — never commit real secrets.
# This hides the FILE, not the VALUE: every VITE_-prefixed variable is inlined
# into the bundle at build time and shipped to every browser. Ignoring
# .env.local does not make a secret in it private — never put one there.
.env
.env.*
!.env.example

# Key material. Nothing here should ever need it; cheap insurance against a
# stray download landing in the repo root.
*.pem
*.key
*.p12
*.keystore

# Testing
coverage/
.vitest-cache/
playwright-report/
test-results/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Agent tooling. launch.json pins an absolute path to the local Node binary,
# so it is per-machine and must not be shared.
.claude/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.eslintcache
.cache/
.temp/
node_modules/.vite/
*.tsbuildinfo
