# Copy to `.env` and adjust. Only VITE_-prefixed vars reach the browser.
# NEVER put secrets in a VITE_ var — they are inlined into the JS bundle.

# Base URL the app calls for backtest data.
# Leave as "/api" in dev to use the Vite proxy (see vite.config.ts) and skip CORS.
VITE_API_BASE_URL=/api

# Request timeout in milliseconds.
VITE_API_TIMEOUT=30000

# Cognito public SPA client. No client secret is used or allowed in the browser.
# Issuer example: https://cognito-idp.us-east-2.amazonaws.com/us-east-2_POOL
VITE_AUTH_AUTHORITY=
VITE_AUTH_CLIENT_ID=
# Managed-login domain, including https:// and without an OAuth path.
VITE_AUTH_DOMAIN=
# Optional: default to this browser origin + /auth/callback and /auth/login.
# These exact URLs must be allowed on the Cognito app client.
VITE_AUTH_REDIRECT_URI=
VITE_AUTH_LOGOUT_REDIRECT_URI=

# Optional local backtest owner: UUID of an existing public.user_creds record.
# Sends X-User-Id only to this backend's backtest endpoints in Vite development.
# Leave empty for normal authentication. Ignored in production builds and when
# Cognito is configured. This header alone never signs in the frontend.
VITE_DEV_USER_ID=

# Start with demo-data panels hidden IN Vite development. They are always
# visible in dev by default and always hidden in production builds; this flag
# only seeds the first dev visit. Exactly "true" or "false".
VITE_DEV_HIDE_DEMO_PANELS=false

# Serve fixture data instead of calling the API, so the MQS Master views render
# before the backend exists. Must be exactly "true" or "false" — anything else
# fails validation at startup. Remove once a Prism mock is running.
VITE_USE_FIXTURES=false

# Build-time only (not exposed to the browser): where the dev proxy forwards to.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
